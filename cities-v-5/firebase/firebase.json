{
  "hosting": {
    "public": "..",
    "ignore": ["firebase/**", "tools/**", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**/*.@(js|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
