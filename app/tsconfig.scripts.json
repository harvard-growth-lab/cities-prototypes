{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.scripts.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,

    /* Node 22 runs scripts/*.ts directly (type stripping). Resolution is
       `bundler`, not `nodenext`, because src/data/*.ts use extensionless
       relative imports that nodenext rejects; the scripts themselves always
       import with explicit .ts extensions so Node's ESM loader resolves them. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["scripts/**/*.ts", "src/data/**/*.ts"]
}
